    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Workshops";
}

<div class="text-center">
    @* Displays the title passed from WorkshopsController.Index(). *@
    <h1>@ViewData["PageTitle"]</h1>

    <p>
        Use this page to register for a workshop
        and view all workshop registrations.
    </p>

    @* Opens the RSVP form using Tag Helpers. *@
    <a class="btn btn-primary"
       asp-controller="Workshops"
       asp-action="RsvpForm">
        Register for a Workshop
    </a>

    @* Opens the registration list using Tag Helpers. *@
    <a class="btn btn-secondary"
       asp-controller="Workshops"
       asp-action="Registrations">
        View Registrations
    </a>
</div>
